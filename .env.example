# Local development. Bun loads this automatically.

# RGIT_WEB_HOSTNAME=127.0.0.1
# RGIT_WEB_PORT=3010

# Path to rgit / rabun-git (defaults to PATH, then ../rabun-git/target/{release,debug})
# RGIT_BIN=/home/ryan/Code/rabun-git/target/debug/rabun-git
# RABUN_GIT_CONFIG=/home/ryan/Code/rabun-git/rabun-git.toml
# RABUN_GIT_ROOT=/home/ryan/Code/rabun-git/data/git

# Invite required for /signup. Unset keeps sign-up closed.
# RGIT_WEB_INVITE_CODE=

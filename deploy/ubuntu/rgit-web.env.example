# Secrets for the systemd unit. Installed to /etc/rgit-web/rgit-web.env (0640).

# Loopback when Caddy terminates TLS. Bind 0.0.0.0 when exposing the port directly.
RGIT_WEB_HOSTNAME=127.0.0.1
RGIT_WEB_PORT=3010

# Forge CLI (same host as rabun-git). Must match rabun-git.service so login
# sees /var/lib/rabun-git, not a cwd-relative data/git under /opt/rgit-web.
# RGIT_BIN=/usr/local/bin/rgit
# RABUN_GIT_CONFIG=/etc/rabun-git/rabun-git.toml
# RABUN_GIT_ROOT=/var/lib/rabun-git
# RABUN_GIT_PUBLIC_HOST=git.example.com

# Invite required for /signup. Unset (default) keeps sign-up closed.
# RGIT_WEB_INVITE_CODE=

# Set when Caddy has a public HTTPS origin.
# RGIT_WEB_SECURE_COOKIES=1
